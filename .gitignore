# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local component stats (views / likes / installs)
/data/component-stats.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# private dev journal (local only — not for git)
dev-journal.md

# backend/architecture notes — local only, same as the journal.
# Contains no secret VALUES (variable names only), but it maps the whole
# auth/data architecture and belongs with the journal rather than in a
# public repo.
backend.md

# agent skill packs installed by `npx skills add` — tooling, not product code,
# and it churns on every skills update
.agents/
skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
